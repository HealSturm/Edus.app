@inherits LayoutComponentBase
@using Gym.app.Theme
@using MudBlazor
@inject ThemeState Theme

<CascadingValue Value="Theme">
    <MudThemeProvider Theme="@CustomTheme.LightTheme" IsDarkMode="@Theme.IsDark" />

    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</CascadingValue>

@code {
    protected override void OnInitialized()
    {
        Theme.OnChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        // Re-render para aplicar el nuevo tema
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Theme.OnChanged -= OnThemeChanged;
    }
}
