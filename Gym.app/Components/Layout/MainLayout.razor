@using Gym.app.Theme
@using MudBlazor
@using Gym.app.Components.Common
@inject ThemeState Theme
@inherits LayoutComponentBase
@implements IDisposable

<CascadingValue Value="Theme">
    <MudThemeProvider Theme="@CustomTheme.LightTheme" IsDarkMode="@Theme.IsDark" />

    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />


    <!-- Banner global para reintento offline -->
    <OfflineRetryBanner />

    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <MudLayout>
                <article class="content px-4">
                    @Body
                </article>
            </MudLayout>
        </main>
    </div>
</CascadingValue>

@code {
    protected override void OnInitialized()
    {
        Theme.OnChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        // Re-render para aplicar el nuevo tema
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Theme.OnChanged -= OnThemeChanged;
    }
}
