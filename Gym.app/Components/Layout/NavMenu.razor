<MudButton Variant="Variant.Text" OnClick="@(() => OpenDrawer(Anchor.Start))">
    <MudIcon Icon="@Icons.Material.Filled.Menu" />
</MudButton>

<MudDrawer @bind-Open="@_open" Anchor="@_anchor" Elevation="1" Variant="@DrawerVariant.Temporary" OverlayAutoClose="@_overlayAutoClose">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Edus Farmacias</MudText>
    </MudDrawerHeader>

    <MudNavMenu>
        <MudNavLink Href="/inicio" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">
            Inicio
        </MudNavLink>
        <MudNavLink Href="/medicinas" Icon="@Icons.Material.Filled.Medication" Match="NavLinkMatch.All">
            Medicinas
        </MudNavLink>
        <MudNavLink Href="/editar-medicina" Icon="@Icons.Material.Filled.MedicalInformation" Match="NavLinkMatch.All">
            Nuevo Medicamento
        </MudNavLink>
        <MudNavLink Href="/usuarios" Icon="@Icons.Material.Filled.Group" Match="NavLinkMatch.All">
            Usuarios
        </MudNavLink>
        <MudNavLink Href="/iniciocliente" Icon="@Icons.Material.Filled.Person" Match="NavLinkMatch.All">
            Inicio de Clientes <!--se cambia luego es para guiarse-->
        </MudNavLink>
        <MudNavLink Href="/" Icon="@Icons.Material.Filled.ExitToApp" Match="NavLinkMatch.All">
            Cerrar Sesión
        </MudNavLink>
        <MudNavLink OnClick="_ => _open = false" Icon="@Icons.Material.Filled.Close">
            Cerrar Menú
        </MudNavLink>
    </MudNavMenu>
</MudDrawer>

@code {
    private bool _open;
    private Anchor _anchor;
    private bool _overlayAutoClose = true;

    private void OpenDrawer(Anchor anchor)
    {
        _open = true;
        _anchor = anchor;
    }
}
