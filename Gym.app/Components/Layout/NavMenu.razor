@using MudBlazor

<MudButton Variant="Variant.Text" OnClick="@(() => OpenDrawer(Anchor.Start))">
    <MudIcon Icon="@Icons.Material.Rounded.Menu" />
</MudButton>

<MudDrawer @bind-Open="@_open" Anchor="@_anchor" Elevation="1" Variant="@DrawerVariant.Temporary" OverlayAutoClose="@_overlayAutoClose">
    <div class="d-flex flex-column h-100">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6" Class="mr-auto">Edus Farmacias</MudText>
        </MudDrawerHeader>

        <MudNavMenu>
            <MudNavLink Href="/inicio" Icon="@Icons.Material.Rounded.Home" Match="NavLinkMatch.All">
                Inicio
            </MudNavLink>
            <MudNavLink Href="/medicinas" Icon="@Icons.Material.Rounded.Medication" Match="NavLinkMatch.All">
                Medicinas
            </MudNavLink>
            <MudNavLink Href="/editar-medicina" Icon="@Icons.Material.Rounded.MedicalInformation" Match="NavLinkMatch.All">
                Nuevo Medicamento
            </MudNavLink>
            <MudNavLink Href="/usuarios" Icon="@Icons.Material.Rounded.Group" Match="NavLinkMatch.All">
                Usuarios
            </MudNavLink>
            <MudNavLink Href="/cliente" Icon="@Icons.Material.Rounded.Person" Match="NavLinkMatch.All">
                Clientes 
            </MudNavLink>
            <MudNavLink Href="/" Icon="@Icons.Material.Rounded.ExitToApp" Match="NavLinkMatch.All">
                Cerrar Sesión
            </MudNavLink>
            <MudNavLink OnClick="_ => _open = false" Icon="@Icons.Material.Rounded.Close">
                Cerrar Menú
            </MudNavLink>
        </MudNavMenu>

        <!-- Empuja la botonera al fondo -->
        <div style="margin-top:auto">
            <MudGrid Justify="Justify.Center" AlignItems="AlignItems.Center" Class="px-3 py-2">
                <MudItem xs="4" sm="4" md="4" Class="d-flex justify-center">
                    <MudIconButton Icon="@Icons.Material.Rounded.LightMode" Size="Size.Medium" Title="Claro" OnClick="@(() => Theme?.SetLight())" />
                </MudItem>
                <MudItem xs="4" sm="4" md="4" Class="d-flex justify-center">
                    <MudIconButton Icon="@Icons.Material.Rounded.DarkMode" Size="Size.Medium" Title="Oscuro" OnClick="@(() => Theme?.SetDark())" />
                </MudItem>
                <MudItem xs="4" sm="4" md="4" Class="d-flex justify-center">
                    <MudIconButton Icon="@Icons.Material.Rounded.BrightnessAuto" Size="Size.Medium" Title="Sistema" OnClick="@(() => Theme?.SetSystem())" />
                </MudItem>
            </MudGrid>
        </div>
    </div>
</MudDrawer>

@code {
    [CascadingParameter] public Gym.app.Theme.ThemeState? Theme { get; set; }

    private bool _open;
    private Anchor _anchor;
    private bool _overlayAutoClose = true;

    private void OpenDrawer(Anchor anchor)
    {
        _open = true;
        _anchor = anchor;
    }
}
