@page "/"
@layout InicioSesionLayout
@using Edus.app.Data.Services
@using Edus.App.Data.Services
@using Microsoft.Maui.Storage;
@using Microsoft.Maui.Networking;
@using Gym.app.Services;

@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ConnectivityService ConnectivityService

<MudContainer MaxWidth="MaxWidth.False" Class="d-flex justify-center align-center" Style="height:100vh; position:relative;">

    <!-- Avatar eliminado de la pantalla de inicio de sesión -->

    <MudPaper Class="pa-6" Elevation="4" Style="width: 90%; max-width: 400px;">
        <MudForm @ref="_form" @bind-IsValid="_formIsValid">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h5" Align="Align.Center">Iniciar sesión</MudText>

                <MudTextField @bind-Value="_username" Label="Usuario (email)" Variant="Variant.Outlined" FullWidth="true" Required="true" RequiredError="Ingrese su usuario" />
                <MudTextField @bind-Value="_password" Label="Contraseña" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" Required="true" RequiredError="Ingrese su contraseña" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@_isLoading" OnClick="Login">
                    @if (_isLoading) { <MudProgressCircular Size="Size.Small" Class="me-2" /> }
                    Entrar
                </MudButton>

                <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
                    <MudLink Href="/registro" Class="mt-2" Color="Color.Primary" Style="text-decoration: underline;">
                        Registrarse
                    </MudLink>
                </MudStack>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form;
    private bool _formIsValid;
    private bool _isLoading;
    private string _username;
    private string _password;

    protected override void OnInitialized()
    {
        ConnectivityService.ConnectivityChanged += OnConnectivityChanged;
    }

    void OnConnectivityChanged(bool isConnected)
    {
        // Mostrar aviso cuando cambia la conectividad
        _ = InvokeAsync(() =>
        {
            if (isConnected)
                Snackbar.Add("Conexión restablecida.", Severity.Success);
            else
                Snackbar.Add("Se perdió la conexión a Internet.", Severity.Warning);
            StateHasChanged();
        });
    }

    private async Task Login()
    {
        await _form.Validate();
        if (!_formIsValid)
        {
            Snackbar.Add("Complete los campos obligatorios.", Severity.Warning);
            return;
        }

        if (!ConnectivityService.IsConnected)
        {
            Snackbar.Add("No hay conexión. Reintentará cuando vuelva la conexión.", Severity.Warning);

            // Encolamos la operación de login para que se ejecute automáticamente cuando haya conexión.
            ConnectivityService.EnqueueRetry(async () =>
            {
                // Ejecutar la lógica de autenticación en el contexto del componente
                await InvokeAsync(async () => await AttemptLoginCoreAsync());
            });

            return;
        }

        await AttemptLoginCoreAsync();
    }

    // Extraemos la lógica que realiza llamadas de red para poder reintentarlo
    private async Task AttemptLoginCoreAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var svc = new dbFBUsuarios();
            var usuarios = await svc.getUsuariosAsync();

            var usuario = usuarios.FirstOrDefault(u =>
                (!string.IsNullOrWhiteSpace(u.Email) && u.Email.Equals(_username, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrWhiteSpace(u.Nombre) && u.Nombre.Equals(_username, StringComparison.OrdinalIgnoreCase)));

            var encryptedInput = cEncriptar256.Encrypt(_password);
            if (usuario == null || usuario.Password != encryptedInput)
            {
                Snackbar.Add("Usuario o contraseña incorrectos.", Severity.Error);
                return;
            }
            if (!string.IsNullOrEmpty(usuario.Nombre))
                await SecureStorage.Default.SetAsync("usuarioNombre", usuario.Nombre);

            if (!string.IsNullOrWhiteSpace(usuario.Role))
                await SecureStorage.Default.SetAsync("role", usuario.Role.Trim());

            var role = usuario.Role?.Trim();
            if (string.Equals(role, "cliente", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/iniciocliente", forceLoad: false);
            }
            else { Navigation.NavigateTo("/inicio", forceLoad: false); }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al autenticar: " + ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        ConnectivityService.ConnectivityChanged -= OnConnectivityChanged;
    }
}
