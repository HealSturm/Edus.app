@page "/editar-medicina"
@page "/editar-medicina/{id:int}"
@using Edus.Share.Model
@using Edus.Bll.Interface
@inject IMedicamento MedicamentoService
@inject ISnackbar Snackbar
@inject NavigationManager navigationManager

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudPaper Class="p-4" Elevation="2">
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">
            @(EsNuevo ? "Agregar Medicamento" : $"Editar Medicamento (ID: {Medicina.IdMedicamento})")
        </MudText>

        <MudForm @ref="Form">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Medicina.Descripcion" Label="Descripción" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Medicina.Presentacion" Label="Presentación" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Medicina.Marca" Label="Marca" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Medicina.Indicaciones" Label="Indicaciones" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Estado" @bind-Value="Medicina.Estado" Required="true">
                        <MudSelectItem Value="@act">Disponible</MudSelectItem>
                        <MudSelectItem Value="@inAct">Agotado</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudStack Direction="Row" Spacing="2" Class="mt-4">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar" Disabled="@Guardando">
                    @(Guardando ? "Guardando..." : "Guardar")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancelar" Disabled="@Guardando">
                    Cancelar
                </MudButton>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public int? id { get; set; }

    private cMedicamento Medicina = new();
    private bool EsNuevo = true;
    private bool Guardando = false;
    private MudForm? Form;

    protected override async Task OnParametersSetAsync()
    {
        await CargarMedicamento();
    }
    public string act = "Activo";
    public string inAct = "Inactivo";


    private async Task CargarMedicamento()
    {
        try
        {
            if (id is null)
            {
                // Nuevo sin id
                Medicina = new cMedicamento { Estado = "Activo" };
                EsNuevo = true;
                return;
            }

            var lista = await MedicamentoService.getMedicamento();
            var existente = lista.FirstOrDefault(m => m.IdMedicamento == id.Value);

            if (existente is not null)
            {
                Medicina = new cMedicamento {
                    IdMedicamento = existente.IdMedicamento,
                    Descripcion = existente.Descripcion,
                    Presentacion = existente.Presentacion,
                    Marca = existente.Marca,
                    Indicaciones = existente.Indicaciones,
                    Estado = string.IsNullOrWhiteSpace(existente.Estado) ? "Activo" : existente.Estado
                };
                EsNuevo = false;
            }
            else
            {
                Medicina = new cMedicamento { IdMedicamento = id.Value, Estado = "Activo" };
                EsNuevo = true;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error cargando medicamento: {ex.Message}", Severity.Error);
        }
    }

    private async Task Guardar()
    {
        await Form!.Validate();
        if (!Form.IsValid) return;

        Guardando = true;
        try
        {
            bool ok = EsNuevo
                ? await MedicamentoService.insertarMedicamento(Medicina)
                : await MedicamentoService.actualizarMedicamento(Medicina);

            Snackbar.Add(ok ? "Medicamento guardado" : "No se pudo guardar",
                ok ? Severity.Success : Severity.Warning);

            if (ok)
                navigationManager.NavigateTo("/medicinas");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
        finally
        {
            Guardando = false;
        }
    }

    private void Cancelar() => navigationManager.NavigateTo("/medicinas");
}
