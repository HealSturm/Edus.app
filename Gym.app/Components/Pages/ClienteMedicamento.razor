@page "/clientemedicamentos/{identificacion}/{nombre}"
@using Edus.Share.Model
@using Edus.Bll.Interface
@using Edus.Share
@inject IClienteFarmacia ClienteService
@inject IMedicamento MedicamentoService
@inject IClienteMedicamento ClienteMedicamentoService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService


<MudContainer MaxWidth="MaxWidth.False" Class="px-4 py-4" Style="min-height:100vh;">
    
   <MudButton OnClick="@Volver">Volver</MudButton>

    <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">
        Medicamentos del Cliente: @nombre
    </MudText>

    <MudStack Spacing="3">
        @if (!string.Equals(_role?.Trim(), "cliente", StringComparison.OrdinalIgnoreCase))
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@AbrirDialogoNuevoMedicamento" Style="align-self:flex-start">
                <MudIcon Icon="@Icons.Material.Filled.Add" />&nbsp;Nuevo Medicamento
            </MudButton>
        }


        @if (MedicamentosCompletos.Any())
        {
            @foreach (var item in MedicamentosCompletos)
            {
                <MudPaper Elevation="3" Class="p-4" Style="border-radius:12px;">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle1">Descripción: @item.Descripcion</MudText>
                            <MudText Typo="Typo.subtitle2">Indicaciones: @item.Indicaciones</MudText>
                            <MudText Typo="Typo.subtitle2">Dosis recomendada: @item.Dosis</MudText>
                        </MudItem>
                        <MudItem xs="12" Class="d-flex justify-end mt-2">
                            @if (!string.Equals(_role?.Trim(), "cliente", StringComparison.OrdinalIgnoreCase))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Secondary" OnClick="@(() => EditarMedicinaCliente(item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => EliminarMedicinaCliente(item))" />
                            }
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        }
        else
        {
            <MudText Color="Color.Error">No hay medicamentos registrados para este cliente.</MudText>
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter] public string identificacion { get; set; }
    [Parameter] public string nombre { get; set; }
    private string? _role;
    private List<cClienteMedicamento> ClienteMedicamentos = new();
    private List<cMedicamento> Medicamentos = new();

    protected override async Task OnInitializedAsync()
    {
        _role = await SecureStorage.Default.GetAsync("role");
        try
        {

            ClienteMedicamentos = await ClienteMedicamentoService.getClienteMedicamentoPorCliente(identificacion);


            Medicamentos = await MedicamentoService.getMedicamento();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error cargando medicamentos: {ex.Message}", Severity.Error);
        }
    }

    private List<MedicamentoClienteView> MedicamentosCompletos => (
        from cm in ClienteMedicamentos
        join m in Medicamentos on cm.IdMedicamento equals m.IdMedicamento
        select new MedicamentoClienteView
        {
            IdMedicamento = m.IdMedicamento,
            Descripcion = m.Descripcion,
            Indicaciones = m.Indicaciones,
            Dosis = cm.Dosis
        }).ToList();

    public class MedicamentoClienteView
    {
        public int IdMedicamento { get; set; }
        public string Descripcion { get; set; }
        public string Indicaciones { get; set; }
        public string Dosis { get; set; }
    }

    private void Volver()
    {
        if (_role == "Cliente" || _role == "cliente")
        {
            Nav.NavigateTo("/iniciocliente");
        }
        else
        {
            Nav.NavigateTo("/cliente");
        }

    }

    private async Task EliminarMedicinaCliente(MedicamentoClienteView medicina)
    {
     try
        {
            var clienteMed = new cClienteMedicamento
            {
                Identificacion = int.Parse(identificacion),
                IdMedicamento = medicina.IdMedicamento,
                Dosis = medicina.Dosis
            };

            bool ok = await ClienteMedicamentoService.borrarClienteMedicamento(clienteMed);

            if (ok)
            {
                Snackbar.Add("Medicamento eliminado correctamente.", Severity.Success);
                ClienteMedicamentos = await ClienteMedicamentoService.getClienteMedicamentoPorCliente(identificacion);
            }
            else
            {
                Snackbar.Add("No se pudo eliminar el medicamento.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private async Task AbrirDialogoNuevoMedicamento()
    {
        var parameters = new DialogParameters
        {
            { "Identificacion", identificacion },
            { "Medicamentos", Medicamentos }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = DialogService.Show<NuevoMedicamentoDialog>("Agregar Medicamento", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Snackbar.Add("Medicamento agregado correctamente.", Severity.Success);
            ClienteMedicamentos = await ClienteMedicamentoService.getClienteMedicamentoPorCliente(identificacion);
        }
    }

    private async Task EditarMedicinaCliente(MedicamentoClienteView item)
    {
        var parameters = new DialogParameters
        {
            { "Identificacion", identificacion },
            { "IdMedicamento", item.IdMedicamento },
            { "DescripcionMedicamento", item.Descripcion },
            { "DosisActual", item.Dosis }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = DialogService.Show<EditarMedicamentoClienteDialog>("Editar Dosis", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
        Snackbar.Add("Dosis actualizada correctamente.", Severity.Success);
        ClienteMedicamentos = await ClienteMedicamentoService.getClienteMedicamentoPorCliente(identificacion);
        }
    }


}