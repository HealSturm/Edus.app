@page "/medicinas"
@using Edus.Share.Model
@using Edus.Bll.Interface
@inject IMedicamento mdsMedicamento 
@inject ISnackbar Snackbar
@inject NavigationManager navigationManager  

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudPaper Class="p-4" Elevation="2">
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">Lista de Medicamentos</MudText>

        <MudTable Items="Medicamentos" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Descripción</MudTh>
                <MudTh>Presentación</MudTh>
                <MudTh>Indicaciones</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Editar</MudTh>
                <MudTh>Eliminar</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Descripción">@context.Descripcion</MudTd>
                <MudTd DataLabel="Presentación">@context.Presentacion</MudTd>
                <MudTd DataLabel="Indicaciones">@context.Indicaciones</MudTd>
                <MudTd DataLabel="Estado">
                    @{
                        var activo = string.Equals(context.Estado, "Activo", StringComparison.OrdinalIgnoreCase);
                        var color = activo ? Color.Success : Color.Error;
                        var texto = activo ? "Disponible" : "Agotado";
                    }
                    <MudChip T="string"
                             Color="@color"
                             Variant="Variant.Filled"
                             Size="Size.Small">
                        @texto
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Editar">
                    <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="@(() => EditarMedicamento(context.IdMedicamento))">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                    </MudButton>
                </MudTd>
                <MudTd DataLabel="Eliminar">
                    <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="@(() => EliminarMedicamento(context.IdMedicamento))">
                        <MudIcon Icon="@Icons.Material.Filled.Delete" />
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No hay medicamentos registrados.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<cMedicamento> Medicamentos = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarMedicamentos();
    }

    private async Task CargarMedicamentos()
    {
        try
        {
            Medicamentos = await mdsMedicamento.getMedicamento();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar medicamentos: {ex.Message}", Severity.Error);
        }
    }

    private async Task EliminarMedicamento(int idMedicamento)
    {
        try
        {
            var resultado = await mdsMedicamento.borrarMedicamento(idMedicamento);
            if (resultado)
            {
                Snackbar.Add("Medicamento eliminado correctamente.", Severity.Success);
                await CargarMedicamentos(); 
            }
            else
            {
                Snackbar.Add("No se pudo eliminar el medicamento.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private void EditarMedicamento(int idMedicamento)
    {
        navigationManager.NavigateTo($"/editar-medicina/{idMedicamento}");
    }
}
