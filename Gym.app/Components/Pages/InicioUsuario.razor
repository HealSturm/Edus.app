@page "/iniciocliente" 
@using Edus.Bll.Interface
@using Edus.Share.Model
@using Edus.app.Data.Services
@inject ISnackbar sb
@inject NavigationManager NavigationManager


<MudContainer Style="height:100vh; width: 100%; display:flex; flex-direction:column;">
    <MudStack Class="pa-4" AlignItems="AlignItems.Center" Spacing="2">
        <MudImage Src="Images/logo.png" Alt="Logo" Style="width:20rem"  Class="mb-2" />
        <MudText Typo="Typo.h4" Align="Align.Center">Edus Farmacias</MudText>
    </MudStack>

    <MudStack Spacing="2" Style="width: 100%;" Class="d-flex justify-center align-center">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width: 90%; height:5rem; display:flex; flex-direction:row; justify-content:start; margin-bottom:2rem" OnClick="@(() => NavigationManager.NavigateTo("/clientemedicamentos"))">
            <MudIcon Icon="@Icons.Material.Filled.Medication" Size="Size.Large" Style="margin-left:1rem"></MudIcon>
            <span Style="margin-left:1rem"></span>
            Medicinas
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width: 90%; height:5rem; display:flex; flex-direction:row; justify-content:start" OnClick="@(() => NavigationManager.NavigateTo("/cliente"))">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Large" Style="margin-left:1rem"></MudIcon>
            <span Style="margin-left:1rem"></span>
            Perfiles/Clientes
        </MudButton>
    </MudStack>
</MudContainer>

