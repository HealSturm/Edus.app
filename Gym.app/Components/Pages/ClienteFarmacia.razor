@page "/cliente"
@using Edus.Share.Model
@using Edus.Bll.Interface
@using Edus.Share
@inject IClienteFarmacia ClienteService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudStack Spacing="4">
        <MudPaper Class="p-4" Elevation="2">
          
            <MudStack Spacing="2">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="NuevoCliente" Style="align-self:flex-start">
                    <MudIcon Icon="@Icons.Material.Filled.Add" />&nbsp;Nuevo
                </MudButton>
                <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Primary">Clientes Farmacia</MudText>
            </MudStack>

            <MudTable Items="Clientes" Hover="true" Dense="true" RowClick="OnRowClick">
                <HeaderContent>
                    <MudTh>Identificación</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Teléfono</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Identificación">@context.Identificacion</MudTd>
                    <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                    <MudTd DataLabel="Teléfono">@context.Telefono</MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Estado">
                        <MudChip T="string" Color="@(context.Estado == "Activo" ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Small">
                            @context.Estado
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(()=> EditarAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error" Size="Size.Small"
                                       OnClick="@(()=>ConfirmarEliminar(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No hay clientes registrados.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        @if (MostrarFormulario)
        {
            <MudPaper Class="p-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">
                    @(EsNuevo ? "Agregar Cliente" : "Editar Cliente")
                </MudText>

                <MudForm @ref="Form">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="ClienteEdit.Identificacion"
                                          Label="Identificación" Required="true"
                                          Disabled="!EsNuevo"
                                          @ref="IdentificacionInput" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="ClienteEdit.Nombre" Label="Nombre" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="FechaNacimientoTemp" Label="Fecha Nacimiento" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="ClienteEdit.Telefono" Label="Teléfono" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="ClienteEdit.Email" Label="Email" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" @bind-Value="ClienteEdit.Estado" Label="Estado" Required="true">
                                <MudSelectItem Value="@act">Activo</MudSelectItem>
                                <MudSelectItem Value="@inAct">Inactivo</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudStack Direction="Row" Spacing="2" Class="mt-4">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar" Disabled="@Guardando">
                            @(Guardando ? "Guardando..." : "Guardar")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelarEdicion" Disabled="@Guardando">
                            Cancelar
                        </MudButton>
                    </MudStack>
                </MudForm>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    private List<cClienteFarmacia> Clientes = new();
    private cClienteFarmacia ClienteEdit = new();
    private bool EsNuevo = true;
    private bool Guardando = false;
    private MudForm? Form;
    private DateTime? FechaNacimientoTemp;
    private bool MostrarFormulario = false;

    private MudTextField<string>? IdentificacionInput;

    public string act = "Activo";
    public string inAct = "Inactivo";

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
        MostrarFormulario = false;
    }

    private async Task CargarClientes()
    {
        try
        {
            Clientes = await ClienteService.getClienteFarmacia();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error cargando clientes: {ex.Message}", Severity.Error);
        }
    }

    private async Task NuevoCliente()
    {
        EsNuevo = true;
        ClienteEdit = new cClienteFarmacia
        {
            FechaNacimiento = DateTime.Today,
            Estado = "Activo"
        };
        FechaNacimientoTemp = ClienteEdit.FechaNacimiento;
        MostrarFormulario = true;

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        if (IdentificacionInput is not null)
            await IdentificacionInput.FocusAsync();
    }

    private async Task EditarAsync(cClienteFarmacia cliente)
    {
        EsNuevo = false;
        ClienteEdit = new cClienteFarmacia
        {
            Identificacion = cliente.Identificacion,
            Nombre = cliente.Nombre,
            FechaNacimiento = cliente.FechaNacimiento,
            Telefono = cliente.Telefono,
            Email = cliente.Email,
            Estado = cliente.Estado
        };
        FechaNacimientoTemp = ClienteEdit.FechaNacimiento;
        MostrarFormulario = true;

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        if (IdentificacionInput is not null)
            await IdentificacionInput.FocusAsync();
    }

    private async Task Guardar()
    {
        await Form!.Validate();
        if (!Form.IsValid) return;
        if (FechaNacimientoTemp is null)
        {
            Snackbar.Add("Seleccione fecha de nacimiento", Severity.Warning);
            return;
        }
        ClienteEdit.FechaNacimiento = FechaNacimientoTemp.Value;

        Guardando = true;
        try
        {
            bool ok = EsNuevo
                ? await ClienteService.insertarClienteFarmacia(ClienteEdit)
                : await ClienteService.actualizarClienteFarmacia(ClienteEdit);

            if (ok)
            {
                Snackbar.Add(EsNuevo ? "Cliente agregado" : "Cliente actualizado", Severity.Success);
                await CargarClientes();
                MostrarFormulario = false;
            }
            else
            {
                Snackbar.Add("Operación no completada", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error guardando cliente: {ex.Message}", Severity.Error);
        }
        finally
        {
            Guardando = false;
        }
    }

    private void CancelarEdicion()
    {
        MostrarFormulario = false;
        ClienteEdit = new();
        FechaNacimientoTemp = null;
        EsNuevo = true;
    }

    private async Task ConfirmarEliminar(cClienteFarmacia cliente)
    {
        var result = await DialogService.ShowMessageBox(
            "Confirmar",
            (MarkupString)$"¿Eliminar cliente <b>{cliente.Nombre}</b> ({cliente.Identificacion})?",
            yesText: "Eliminar",
            cancelText: "Cancelar",
            options: new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, CloseButton = true });
        if (result != true) return;

        try
        {
            bool ok = await ClienteService.borrarClienteFarmacia(new cClienteFarmacia { Identificacion = cliente.Identificacion });
            if (ok)
            {
                Snackbar.Add("Cliente eliminado", Severity.Success);
                await CargarClientes();

                if (MostrarFormulario && !EsNuevo && ClienteEdit.Identificacion == cliente.Identificacion)
                    MostrarFormulario = false;
            }
            else
            {
                Snackbar.Add("No se pudo eliminar", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnRowClick(TableRowClickEventArgs<cClienteFarmacia> args)
        => await EditarAsync(args.Item);
}
