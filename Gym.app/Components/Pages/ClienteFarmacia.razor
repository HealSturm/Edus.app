@page "/cliente"
@using Edus.Share.Model
@using Edus.Bll.Interface
@using Edus.Share
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@inject IClienteFarmacia ClienteService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudStack Spacing="4">
        <MudPaper Class="p-4" Elevation="2">

            <MudStack Spacing="2">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="NuevoCliente" Style="align-self:flex-start">
                    <MudIcon Icon="@Icons.Material.Filled.Add" />&nbsp;Nuevo
                </MudButton>
                <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Primary">Clientes Farmacia</MudText>
            </MudStack>

            <MudTable Items="Clientes" Hover="true" Dense="true" RowClick="OnRowClick">
                <HeaderContent>
                    <MudTh>Identificación</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Teléfono</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh></MudTh>
                    <MudTh>Medicinas</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Identificación">@context.Identificacion</MudTd>
                    <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                    <MudTd DataLabel="Teléfono">@context.Telefono</MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Estado">
                        <MudChip T="string" Color="@(context.Estado == "Activo" ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Small">
                            @context.Estado
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(()=> EditarAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error" Size="Size.Small"
                                       OnClick="@(()=>ConfirmarEliminar(context))" />
                    </MudTd>
                    <MudTd>
                        <MudButton OnClick="@(()=> VerMedicinas(context))">Medicinas</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    @if (ErrorCarga)
                    {
                        <MudText>No hay clientes registrados.</MudText>
                    }
                    else
                    {
                        
                        <MudText Color="Color.Error">No se han cargado los datos revisa que tambien estes usando el Web Api</MudText>
                    }
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        @if (MostrarFormulario)
        {
            <MudPaper Class="p-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">
                    @(EsNuevo ? "Agregar Cliente" : "Editar Cliente")
                </MudText>

                <MudForm @ref="Form" Model="@ClienteEdit" ValidationDelay="0">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="ClienteEdit.Identificacion"
                                          Label="Identificación"
                                          Required="true"
                                          RequiredError="La identificación es requerida"
                                          Disabled="!EsNuevo"
                                          Validation="@(new Func<string, string>(ValidarIdentificacion))"
                                          @ref="IdentificacionInput" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="ClienteEdit.Nombre"
                                          Label="Nombre"
                                          Required="true"
                                          RequiredError="El nombre es requerido"
                                          Validation="@(new Func<string, string>(ValidarNombre))" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="FechaNacimientoTemp"
                                           Label="Fecha Nacimiento"
                                           Required="true"
                                           RequiredError="La fecha de nacimiento es requerida"
                                           MaxDate="DateTime.Today"
                                           Validation="@(new Func<DateTime?, string>(ValidarFechaNacimiento))" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="ClienteEdit.Telefono"
                                          Label="Teléfono"
                                          Validation="@(new Func<string, string>(ValidarTelefono))" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="ClienteEdit.Email"
                                          Label="Email"
                                          Validation="@(new Func<string, string>(ValidarEmail))" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" @bind-Value="ClienteEdit.Estado"
                                       Label="Estado"
                                       Required="true"
                                       RequiredError="El estado es requerido">
                                <MudSelectItem Value="@act">Activo</MudSelectItem>
                                <MudSelectItem Value="@inAct">Inactivo</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudStack Direction="Row" Spacing="2" Class="mt-4">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar" Disabled="@Guardando">
                            @(Guardando ? "Guardando..." : "Guardar")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelarEdicion" Disabled="@Guardando">
                            Cancelar
                        </MudButton>
                    </MudStack>
                </MudForm>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    private List<cClienteFarmacia> Clientes = new();
    private cClienteFarmacia ClienteEdit = new();
    private bool EsNuevo = true;
    private bool Guardando = false;
    private MudForm? Form;
    private DateTime? FechaNacimientoTemp;
    private bool MostrarFormulario = false;
    private bool ErrorCarga = false; // Indicador de fallo al cargar

    private MudTextField<string>? IdentificacionInput;

    public string act = "Activo";
    public string inAct = "Inactivo";

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
        MostrarFormulario = false;
    }

    private async Task CargarClientes()
    {
        try
        {
            Clientes = await ClienteService.getClienteFarmacia();
            ErrorCarga = false;
        }
        catch (Exception ex)
        {
            ErrorCarga = true;
            Snackbar.Add($"Error cargando clientes: {ex.Message}", Severity.Error);
        }
    }

    private async Task NuevoCliente()
    {
        EsNuevo = true;
        ClienteEdit = new cClienteFarmacia
        {
            FechaNacimiento = DateTime.Today,
            Estado = "Activo"
        };
        FechaNacimientoTemp = ClienteEdit.FechaNacimiento;
        MostrarFormulario = true;

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        if (IdentificacionInput is not null)
            await IdentificacionInput.FocusAsync();
    }

    private async Task EditarAsync(cClienteFarmacia cliente)
    {
        EsNuevo = false;
        ClienteEdit = new cClienteFarmacia
        {
            Identificacion = cliente.Identificacion,
            Nombre = cliente.Nombre,
            FechaNacimiento = cliente.FechaNacimiento,
            Telefono = cliente.Telefono,
            Email = cliente.Email,
            Estado = cliente.Estado
        };
        FechaNacimientoTemp = ClienteEdit.FechaNacimiento;
        MostrarFormulario = true;

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        if (IdentificacionInput is not null)
            await IdentificacionInput.FocusAsync();
    }

    private async Task Guardar()
    {
        await Form!.Validate();

        if (!Form.IsValid)
        {
            Snackbar.Add("Por favor corrija los errores en el formulario", Severity.Warning);
            return;
        }

        if (FechaNacimientoTemp is null)
        {
            Snackbar.Add("Seleccione fecha de nacimiento", Severity.Warning);
            return;
        }

        ClienteEdit.FechaNacimiento = FechaNacimientoTemp.Value;

        if (EsNuevo && Clientes.Any(c => c.Identificacion == ClienteEdit.Identificacion))
        {
            Snackbar.Add("Ya existe un cliente con esta identificación", Severity.Warning);
            return;
        }

        Guardando = true;
        try
        {
            bool ok = EsNuevo
                ? await ClienteService.insertarClienteFarmacia(ClienteEdit)
                : await ClienteService.actualizarClienteFarmacia(ClienteEdit);

            if (ok)
            {
                Snackbar.Add(EsNuevo ? "Cliente agregado correctamente" : "Cliente actualizado correctamente", Severity.Success);
                await CargarClientes();
                MostrarFormulario = false;
            }
            else
            {
                Snackbar.Add("Operación no completada", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error guardando cliente: {ex.Message}", Severity.Error);
        }
        finally
        {
            Guardando = false;
        }
    }

    private void CancelarEdicion()
    {
        MostrarFormulario = false;
        ClienteEdit = new();
        FechaNacimientoTemp = null;
        EsNuevo = true;
    }

    private async Task ConfirmarEliminar(cClienteFarmacia cliente)
    {
        var result = await DialogService.ShowMessageBox(
            "Confirmar",
            (MarkupString)$"¿Eliminar cliente <b>{cliente.Nombre}</b> ({cliente.Identificacion})?",
            yesText: "Eliminar",
            cancelText: "Cancelar",
            options: new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, CloseButton = true });
        if (result != true) return;

        try
        {
            bool ok = await ClienteService.borrarClienteFarmacia(new cClienteFarmacia { Identificacion = cliente.Identificacion });
            if (ok)
            {
                Snackbar.Add("Cliente eliminado correctamente", Severity.Success);
                await CargarClientes();

                if (MostrarFormulario && !EsNuevo && ClienteEdit.Identificacion == cliente.Identificacion)
                    MostrarFormulario = false;
            }
            else
            {
                Snackbar.Add("No se pudo eliminar el cliente", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnRowClick(TableRowClickEventArgs<cClienteFarmacia> args)
        => await EditarAsync(args.Item);

    private string ValidarIdentificacion(string identificacion)
    {
        if (string.IsNullOrWhiteSpace(identificacion))
            return "La identificación es requerida";

        if (identificacion.Length < 5)
            return "La identificación debe tener al menos 5 caracteres";

        if (identificacion.Length > 20)
            return "La identificación no puede exceder 20 caracteres";

        return null;
    }

    private string ValidarNombre(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "El nombre es requerido";

        if (nombre.Length < 3)
            return "El nombre debe tener al menos 3 caracteres";

        if (nombre.Length > 100)
            return "El nombre no puede exceder 100 caracteres";

        if (!Regex.IsMatch(nombre, @"^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$"))
            return "El nombre solo puede contener letras y espacios";

        return null;
    }

    private string ValidarFechaNacimiento(DateTime? fecha)
    {
        if (fecha is null)
            return "La fecha de nacimiento es requerida";

        if (fecha.Value > DateTime.Today)
            return "La fecha de nacimiento no puede ser futura";

        var edad = DateTime.Today.Year - fecha.Value.Year;
        if (fecha.Value.Date > DateTime.Today.AddYears(-edad)) edad--;

        if (edad < 0)
            return "La fecha de nacimiento no es válida";

        if (edad > 120)
            return "La fecha de nacimiento no parece válida (edad mayor a 120 años)";

        return null;
    }

    private string ValidarTelefono(string telefono)
    {
        if (string.IsNullOrWhiteSpace(telefono))
            return null;

        var telefonoLimpio = Regex.Replace(telefono, @"[\s\-\(\)]", "");

        if (telefonoLimpio.Length < 8)
            return "El teléfono debe tener al menos 8 dígitos";

        if (telefonoLimpio.Length > 15)
            return "El teléfono no puede exceder 15 dígitos";

        if (!Regex.IsMatch(telefono, @"^[\d\s\-\(\)\+]+$"))
            return "El teléfono solo puede contener números, espacios, guiones, paréntesis y el símbolo +";

        return null;
    }

    private string ValidarEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return null;

        if (email.Length > 100)
            return "El email no puede exceder 100 caracteres";

        var emailRegex = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        if (!Regex.IsMatch(email, emailRegex))
            return "El formato del email no es válido";

        return null;
    }

     private async Task VerMedicinas(cClienteFarmacia cliente)
    {
         Nav.NavigateTo($"/clientemedicamentos/{cliente.Identificacion}/{cliente.Nombre}");
    }
}